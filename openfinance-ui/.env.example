# Backend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Application Environment
VITE_ENV=development

# Optional mortgage-conversion preset matching (blank = no automatic preset).
# Put deployment-specific identifiers in the ignored .env.local file.
# Vite reads these at dev-server startup/build time; they are client configuration, not secrets.
# Example values: account "00000000001", property "Example residence".
VITE_IMPORT_MORTGAGE_PRESET_ACCOUNT_NAME=
VITE_IMPORT_MORTGAGE_PRESET_PROPERTY_NAME=
